DISCOENV_DB_URI=postgresql://db.example.org:5432/de?sslmode=disable
DISCOENV_DB_SCHEMA=public
DISCOENV_ICAT_URI=postgresql://icat.example.org:5432/ICAT?sslmode=disable
DISCOENV_ICAT_ZONE=iplant
DISCOENV_AMQP_URI=amqp://username:password@amqp.example.org:5672/vhost
DISCOENV_AMQP_EXCHANGE_NAME=de
DISCOENV_AMQP_EXCHANGE_TYPE=topic
DISCOENV_AMQP_QUEUEPREFIX=
DISCOENV_AMQP_BATCHSIZE=100
DISCOENV_DATAUSAGE_REFRESHINTERVAL=3h
DISCOENV_USERS_DOMAIN=example.org
DISCOENV_QMS_ENABLED=true

# icat.rootresources is a list, which the environment cannot express: koanf reads
# DISCOENV_* values as plain strings. Set it in the configuration file instead.
